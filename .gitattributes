# پایان خط همه‌جا LF. بدون این، کلون روی ویندوز با autocrlf همه فایل‌ها
# را CRLF می‌کند و اولین کامیت، کل مخزن را بازنویسی‌شده نشان می‌دهد.
* text=auto eol=lf

*.php text eol=lf
*.md  text eol=lf

# گیتهاب مسیر examples/ را «مستندات» می‌شمارد و از آمار زبان کنار می‌گذارد،
# پس مخزنی که همه کدش آنجاست اصلاً بدون زبان دیده می‌شود. این خط همان
# برچسب را برمی‌دارد.
examples/** linguist-documentation=false
